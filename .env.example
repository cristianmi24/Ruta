# Copia este archivo como .env (local) y configura las mismas variables en Vercel (Project Settings > Environment Variables).
# Ninguna lleva prefijo VITE_: viven solo en el servidor (/api) y nunca llegan al navegador.

# Base de datos PostgreSQL en Neon (cadena de conexión "pooled")
DATABASE_URL="postgresql://USUARIO:CLAVE@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Firma de los JWT (consentimiento del estudiante y sesión de coordinación). Mínimo 32 caracteres aleatorios.
JWT_SECRET="genera-una-cadena-larga-y-aleatoria"

# Cifrado AES-256-GCM de correo y teléfono en la base de datos. Mínimo 32 caracteres. No la cambies después de tener datos.
DATA_ENCRYPTION_KEY="genera-otra-cadena-larga-y-aleatoria"

# Qwen directo (Alibaba Cloud Model Studio / DashScope, modo compatible con OpenAI). Sin clave se usa el reporte local.
# Internacional: https://dashscope-intl.aliyuncs.com/compatible-mode/v1/chat/completions
# China:         https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
QWEN_API_KEY=""
QWEN_BASE_URL="https://dashscope-intl.aliyuncs.com/compatible-mode/v1/chat/completions"
QWEN_MODEL="qwen-plus"
